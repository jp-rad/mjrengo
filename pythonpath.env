# code/pythonpath.env

# vscode - settings.json - "python.envFile"

# PYTHONPATH used by VS Code when running or debugging Python.
# pytest.ini is NOT used by VS Code, so the same paths must be listed here.
# Note: Pylance (IntelliSense) does NOT read .env files, so settings.json
# must also include these paths in python.analysis.extraPaths.
CODEDIR=/home/vscode/dev/code
PYTHONPATH=${CODEDIR}

PYTHONPATH=${PYTHONPATH}:${CODEDIR}/mjrengo/src

GLYPHDIR=${CODEDIR}/glyph
PYTHONPATH=${PYTHONPATH}:${GLYPHDIR}/template-v0_1_0/src
PYTHONPATH=${PYTHONPATH}:${GLYPHDIR}/mj-v6_02_201/src
PYTHONPATH=${PYTHONPATH}:${GLYPHDIR}/mj-v6_02_201_onka/src
PYTHONPATH=${PYTHONPATH}:${GLYPHDIR}/mj_plus-v4_10/src
PYTHONPATH=${PYTHONPATH}:${GLYPHDIR}/mj_plusx-v1_20/src

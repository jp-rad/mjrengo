{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build package mjrengo",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "build"
            ],
            "options": {
                // Set the working directory to 'mjrengo' folder
                "cwd": "${workspaceFolder}/code/mjrengo",
            },
            "problemMatcher": []
        },
        {
            "label": "install package mjrengo",
            "type": "shell",
            "command": "pip3",
            "args": [
                "install",
                "--upgrade",
                ".",
            ],
            "options": {
                // Set the working directory to 'mjrengo' folder
                "cwd": "${workspaceFolder}/code/mjrengo",
            },
            "problemMatcher": []
        },
        {
            "label": "build package mjrengo_data_mj",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "build"
            ],
            "options": {
                // Set the working directory to 'mjrengo_data_mj' folder
                "cwd": "${workspaceFolder}/code/mjrengo_data_mj",
            },
            "problemMatcher": []
        },
        {
            "label": "install package mjrengo_data_mj",
            "type": "shell",
            "command": "pip3",
            "args": [
                "install",
                "--upgrade",
                ".",
            ],
            "options": {
                // Set the working directory to 'mjrengo_data_mj' folder
                "cwd": "${workspaceFolder}/code/mjrengo_data_mj",
            },
            "problemMatcher": []
        },
        {
            "label": "build package mjrengo_data_mj_plus",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "build"
            ],
            "options": {
                // Set the working directory to 'mjrengo_data_mj_plus' folder
                "cwd": "${workspaceFolder}/code/mjrengo_data_mj_plus",
            },
            "problemMatcher": []
        },
        {
            "label": "install package mjrengo_data_mj_plus",
            "type": "shell",
            "command": "pip3",
            "args": [
                "install",
                "--upgrade",
                ".",
            ],
            "options": {
                // Set the working directory to 'mjrengo_data_mj_plus' folder
                "cwd": "${workspaceFolder}/code/mjrengo_data_mj_plus",
            },
            "problemMatcher": []
        },
        {
            "label": "uninstall packages",
            "type": "shell",
            "command": "pip3",
            "args": [
                "uninstall",
                "-y",
                "mjrengo",
                "mjrengo_data_mj",
                "mjrengo_data_mj_plus",
            ],
            "problemMatcher": []
        },
        {
            "label": "compile mjrengo.data",
            "type": "shell",
            "command": "python",
            "args": [
                "tools/compilers/compiler_glyph.py"
            ],
            "options": {
                // Set the working directory to 'code' folder
                "cwd": "${workspaceFolder}/code",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/code:${workspaceFolder}/code/mjrengo/src"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "rebuild package",
            "dependsOn": [
                "compile mjrengo.data",
                "build package mjrengo",
                "install package mjrengo",
                "build package mjrengo_data_mj",
                "install package mjrengo_data_mj",
                "build package mjrengo_data_mj_plus",
                "install package mjrengo_data_mj_plus",
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
    ]
}
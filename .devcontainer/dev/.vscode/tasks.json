    "version": "2.0.0",
    "tasks": [
        {
            "label": "pdoc3 package mjrengo",
            "type": "shell",
            "command": "pdoc",
            "args": [
                "mjrengo",
                "-o",
                "../docs",
                "--force",
                "--html",
            ],
            "options": {
                // Set the working directory to 'mjrengo/src' folder
                "cwd": "${workspaceFolder}/code/mjrengo/src",
            },
            "problemMatcher": []
        },
        {
            "label": "build package mjrengo",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "build"
            ],
            "options": {
                // Set the working directory to 'mjrengo' folder
                "cwd": "${workspaceFolder}/code/mjrengo",
            },
            "problemMatcher": []
        },
        {
            "label": "install package mjrengo",
            "type": "shell",
            "command": "pip3",
            "args": [
                "install",
                "--upgrade",
                "--no-deps",
                ".",
            ],
            "options": {
                // Set the working directory to 'mjrengo' folder
                "cwd": "${workspaceFolder}/code/mjrengo",
            },
            "problemMatcher": []
